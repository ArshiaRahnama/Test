# Blocks direct web access to the SQLite database and internal library files.
# (If your host runs Nginx instead of Apache, this file has no effect — see
# README.md for the equivalent Nginx config you need to add manually.)

<FilesMatch "\.(db|db-journal|sqlite|sqlite3)$">
  Require all denied
</FilesMatch>

<FilesMatch "^schema\.sql$">
  Require all denied
</FilesMatch>

<Files "local-config.php">
  Require all denied
</Files>

